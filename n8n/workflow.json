    {
      "parameters": {
        "jsCode": "return $input.all();"
      },
      "id": "cb-node-003",
      "name": "Split Into Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        620,
        340
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_GROQ_API_KEY_HERE"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ model: 'llama-3.1-8b-instant', messages: [{ role: 'system', content: 'You are a skill categorizer for a recruitment platform. Given a pipe-separated list of skills, return ONLY ONE category from: automation-heavy, web-dev, data, design, full-stack, other. Return the category word and nothing else. No punctuation.' }, { role: 'user', content: 'Skills: ' + $json.skills }], max_tokens: 10, temperature: 0 }) }}",
        "options": {}
      },
      "id": "cb-node-004",
      "name": "Tag Skills with Groq LLM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        840,
        340
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.item.json.choices[0].message.content;\nconst category = raw.trim().toLowerCase().replace(/[^a-z-]/g, '');\nconst id = $('Split Into Items').item.json.id;\nreturn {\n  json: {\n    id: id,\n    skill_category: category\n  }\n};"
      },
      "id": "cb-node-005",
      "name": "Extract Category",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1060,
        340
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:5001/api/update_category",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ id: $json.id, skill_category: $json.skill_category }) }}",
        "options": {}
      },
      "id": "cb-node-006",
      "name": "Write Category to DB",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1280,
